///| 零 API key、零注册的本地演示。
///
///   moon run --target native scripts/demo.mbtx
///
/// 起一个假的 OpenAI 兼容端点，然后把三条主要路径各走一遍：单次问答、流式输出、
/// 两个「模型」的对比。全程离线。第一次接触这个项目的话，从这里开始最省事。
///
/// 这是 scripts/demo.sh 的 .mbtx 版。想换成真实网关，见 README 的 Quick start。
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs" @fs,
  "moonbitlang/async@0.21.3/io" @io,
  "moonbitlang/async@0.21.3/process" @process,
  "moonbitlang/async@0.21.3/stdio" @stdio,
  "moonbitlang/core/env" @env,
}

///|
extern "c" fn c_exit(code : Int) -> Unit = "exit"

///|
/// 走 @stdio.stdout.write 而不是 println：`show` 把子进程的输出写在同一条路上，
/// 而重定向到管道/文件时 println 是块缓冲的——混用的话顺序会乱（跑出来就是
/// 「模型输出」排在「==> 构建」前面）。
async fn say(message : String) -> Unit {
  @stdio.stdout.write(message + "\n") catch { _ => () }
}

///|
fn text_of(data : &@io.Data) -> String {
  data.text() catch { _ => "" }
}


///|
async fn copy_file(from : String, to : String) -> Bool {
  let content = @fs.read_file(from) catch { _ => return false }
  @fs.write_file(to, content, create_mode=@fs.CreateOrTruncate) catch {
    _ => return false
  }
  true
}

///|
async fn bin_path(path_without_suffix : String) -> String {
  let exe = path_without_suffix + ".exe"
  if (@fs.exists(exe) catch { _ => false }) {
    exe
  } else {
    path_without_suffix
  }
}

///|
/// 编译一个 .mbtx 并复制成独立文件，返回**实际可执行的路径**。
///
/// 返回路径而不是 Bool：Windows 上可执行文件必须带 .exe，而复制过来的副本
/// 名字是我们起的——不带后缀的话 spawn 会找不到它（真的这么踩过）。
///|
/// 每个子脚本用**自己的** target-dir。
///
/// 默认情况下所有 .mbtx 的单文件产物都落在同一个 single/single.exe 上，于是两个
/// 脚本同时构建就会互相顶掉。按子脚本文件名分开之后，各自的构建互不相干，
/// 并发的目标才敢同时跑
fn mbtx_dir(src : String) -> String {
  let mut base = src
  for part in src.split("/") {
    if part != "" {
      base = part.to_owned()
    }
  }
  "scripts/_build/mbtx/" + base
}

///|
async fn build_mbtx(src : String, out_base : String) -> String? {
  let dir = mbtx_dir(src)
  let (code, _, err) = @process.collect_output(
    "moon",
    ["build", "--target", "native", "--target-dir", dir, src],
    inherit_env=true,
  ) catch {
    _ => return None
  }
  if code != 0 {
    @stdio.stderr.write(text_of(err) + "\n") catch { _ => () }
    return None
  }
  // moon 在 target-dir 之下又会拼一层源文件名，所以产物在 dir/<源文件名>/... 下
  let mut leaf = ""
  for part in dir.split("/") {
    if part != "" {
      leaf = part.to_owned()
    }
  }
  let single_exe = dir + "/" + leaf + "/native/debug/build/single/single.exe"
  let single = if (@fs.exists(single_exe) catch { _ => false }) {
    single_exe
  } else {
    dir + "/" + leaf + "/native/debug/build/single/single"
  }
  // 平台怎么命名构建产物，副本就怎么命名：Windows 上必须是 .exe
  let target = if single.has_suffix(".exe") {
    out_base + ".exe"
  } else {
    out_base
  }
  if !copy_file(single, target) {
    return None
  }
  @fs.chmod(target, 0o755) catch { _ => () }
  Some(target)
}

///|
/// 跑一个进程，输出直接透到本终端的 stdout/stderr（demo 就是给人看的）。
async fn show(bin : String, args : Array[String], env : Map[String, String]) -> Int {
  let (code, out, err) = @process.collect_output(
    bin,
    args,
    extra_env=env,
    inherit_env=true,
  ) catch {
    err => {
      @stdio.stderr.write(err.to_string() + "\n") catch { _ => () }
      return -1
    }
  }
  @stdio.stdout.write(text_of(out)) catch { _ => () }
  @stdio.stderr.write(text_of(err)) catch { _ => () }
  code
}

///|
async fn main {
  say("==> 构建（第一次会编译依赖，稍慢）")
  let built = show("moon", ["build", "--target", "native"], {})
  if built != 0 {
    say("构建失败")
    c_exit(1)
    return
  }
  let tmp = @fs.tmpdir(prefix="demo") catch { _ => "" }
  if tmp == "" {
    say("建不了临时目录")
    c_exit(1)
    return
  }
  @fs.mkdir(tmp, recursive=true) catch { _ => () }

  say("")
  say("==> 编译本地假端点与检查器")
  let mock_bin = match build_mbtx("scripts/mock_openai.mbtx", tmp + "/mock-endpoint") {
    Some(path) => path
    None => {
      say("假端点编译失败")
      c_exit(1)
      return
    }
  }
  if build_mbtx("scripts/check_incremental.mbtx", tmp + "/check-incremental") is None {
    say("检查器编译失败")
    c_exit(1)
    return
  }

  let client = bin_path("_build/native/debug/build/cmd/faceoff/faceoff")
  let bench = bin_path("_build/native/debug/build/cmd/bench/bench")

  @async.with_task_group(async fn(group) {
    say("")
    say("==> 启动本地假端点")
    let (reader, sink) = @process.read_from_process() catch {
      _ => {
        say("建不了读取管道")
        return
      }
    }
    let mock = @process.spawn(
      group,
      mock_bin,
      [],
      extra_env={ "MOCK_STREAM_DELAY": "0.05" },
      inherit_env=true,
      stdout=sink,
      stderr=@process.redirect_to_file(
        tmp + "/mock.log",
        create_mode=@fs.CreateOrTruncate,
      ),
      cancel_handler=@process.graceful_cancel(timeout=2000),
    ) catch {
      _ => {
        say("假端点起不来")
        return
      }
    }
    let port = read_line(reader, 15000)
    if port == "" {
      say("假端点没起来：" + read_file_quiet(tmp + "/mock.log"))
      return
    }
    let base_url = "http://127.0.0.1:" + port + "/v1"
    say("    " + base_url)
    let keyed : Map[String, String] = {
      "MOONLLM_BASE_URL": base_url,
      "MOONLLM_API_KEY": "test-key",
    }

    say("")
    say("==> 1/3 单次问答")
    ignore(show(client, ["用一句话说明什么是航空母舰"], keyed))

    say("")
    say("==> 2/3 流式输出（碎片逐个到达）")
    ignore(show(client, ["--stream", "写一句关于侧风的话"], keyed))

    say("")
    say("==> 3/3 两个「模型」的对比（各 1 次）")
    ignore(
      show(
        bench,
        [
          "--models", "mock-a,mock-b",
          "--prompt", "用一句话说明什么是航空母舰",
          "--repeats", "1", "--max-tokens", "64",
          "--pace-ms", "0", "--retry", "0",
        ],
        keyed,
      ),
    )

    mock.cancel()
    ignore(mock.wait() catch { _ => -1 })
  })

  say("")
  say("演示结束。换成真实网关：")
  say("")
  say("  export MOONLLM_BASE_URL=https://api.deepseek.com/v1   # 任何 OpenAI 兼容地址")
  say("  export MOONLLM_MODEL=deepseek-chat")
  say("  export MOONLLM_API_KEY=sk-...")
  say("  \{client} --stream \"你好\"")
}

///|
/// 只给错误提示用：读不到就空串。
async fn read_file_quiet(path : String) -> String {
  let data = @fs.read_file(path) catch { _ => return "" }
  text_of(data)
}

///|
/// 从读者里读一行（含超时）。假端点的端口就是它的 stdout 第一行。
async fn read_line(reader : @process.ReadFromProcess, timeout_ms : Int) -> String {
  let line = @async.with_timeout_opt(timeout_ms, async fn() {
    reader.read_until("\n")
  }) catch { _ => None }
  match line {
    Some(Some(text)) => text.trim(chars=" \t\r\n").to_owned()
    _ => ""
  }
}
