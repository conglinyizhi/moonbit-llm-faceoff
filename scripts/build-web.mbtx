///| 构建前端：先把评测结果导出成页面数据，再让包里的页面构建器干活。
///
///   moon run --target native scripts/build-web.mbtx [path/to/results.jsonl]
///
///   results.jsonl → bench（replay） → web/data.json   页面数据（静态报告用）
///   web/data.json → web/cmd/build   → web/out/        交互页 + 静态报告
///
/// 页面构建（ssg 出 site.css/report.html、app 出 app.js、复制外壳）只有一份实现：
/// web/cmd/build。它在包里，从 mooncakes 下载模块的人用的是同一个入口。这里只多做
/// 前面那一步导出，因为它要用 bench CLI。
///
/// 不带参数就用 bench/results-example.jsonl。只重新导出页面数据时不需要真的调用
/// 模型：bench --from-json 走 replay 路径。
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs" @fs,
  "moonbitlang/async@0.21.3/io" @io,
  "moonbitlang/async@0.21.3/process" @process,
  "moonbitlang/async@0.21.3/stdio" @stdio,
  "moonbitlang/core/env",
}

///|
extern "c" fn c_exit(code : Int) -> Unit = "exit"

///|
fn text_of(data : &@io.Data) -> String {
  data.text() catch { _ => "" }
}

///|
async fn say(message : String) -> Unit {
  @stdio.stdout.write(message + "\n") catch { _ => () }
}

///|
async fn note(message : String) -> Unit {
  @stdio.stderr.write(message + "\n") catch { _ => () }
}


///|
async fn exists(path : String) -> Bool {
  @fs.exists(path) catch { _ => false }
}

///|
// 注意：可执行文件路径要**绝对**，即使同时给了 cwd。
// 带 cwd 的相对路径在 POSIX 上没事（fork 之后再 exec，路径那时才解析），
// 而 Windows 的 CreateProcess 不是这么干的——它会「找不到文件」（真的踩过）。
///|
/// 文件 A 是不是比 B 新（B 不存在也算「A 更新」）。
async fn newer_than(a : String, b : String) -> Bool {
  if !exists(b) {
    return true
  }
  let left = @fs.mtime(a) catch { _ => return false }
  let right = @fs.mtime(b) catch { _ => return true }
  left.0 > right.0 || (left.0 == right.0 && left.1 > right.1)
}

///|
async fn run(
  bin : String,
  args : Array[String],
  cwd : String,
) -> (Int, String, String) {
  let (code, out, err) = @process.collect_output(
    bin,
    args,
    inherit_env=true,
    cwd=cwd,
  ) catch {
    err => return (-1, "", err.to_string())
  }
  (code, text_of(out), text_of(err))
}

///|
/// 同一个二进制的两种可能命名。
/// 用存在性判断，不靠 spawn 失败——失败原因有很多，分不清是「没这个文件」还是别的。
async fn run_binary(
  cwd : String,
  path_without_suffix : String,
  args : Array[String],
) -> (Int, String, String) {
  if exists(path_without_suffix + ".exe") {
    return run(path_without_suffix + ".exe", args, cwd)
  }
  run(path_without_suffix, args, cwd)
}

///|
async fn main {
  let args = @env.args().filter(fn(arg) { arg != "--" })
  let root = match @env.current_dir() {
    Some(dir) => dir
    None => {
      note("build-web: 拿不到当前目录")
      c_exit(1)
      return
    }
  }
  let results = if args.length() > 1 {
    args[args.length() - 1]
  } else {
    "bench/results-example.jsonl"
  }
  if !exists(results) {
    note("error: no results log at " + results)
    c_exit(1)
    return
  }

  // 只重新导出页面数据时不必真的调模型：bench --from-json 走 replay。
  let data_path = "web/data.json"
  if newer_than(results, data_path) {
    say("==> 从 " + results + " 导出 " + data_path)
    let (build_code, _, build_err) = run(
      "moon",
      ["build", "cmd/bench", "--target", "native"],
      root,
    )
    if build_code != 0 {
      note(build_err)
      c_exit(1)
      return
    }
    let (code, _, err) = run_binary(
      root,
      root + "/_build/native/debug/build/cmd/bench/bench",
      ["--from-json", results, "--no-key", "--web-data", data_path],
    )
    if code != 0 {
      note(err)
      c_exit(1)
      return
    }
  } else {
    // 静默用旧数据会让人以为「我明明传了这个文件，怎么报告还是上一轮的」——
    // 所以这里必须出声。
    say("==> web/data.json 比 " + results + " 新，跳过导出")
    say("    报告用的是 web/data.json 里的数据。要强制从 " + results + " 重建：")
    say("      rm web/data.json && moon run --target native scripts/build-web.mbtx " + results)
  }

  let web = root + "/web"
  @fs.mkdir(web + "/out", recursive=true) catch { _ => () }

  say("==> 页面构建（交给包里的 web/cmd/build，同一份实现）")
  let (page_code, page_out, page_err) = run(
    "moon",
    ["run", "--target", "native", "web/cmd/build"],
    root,
  )
  @stdio.stdout.write(page_out) catch { _ => () }
  if page_code != 0 {
    note(page_err)
    c_exit(1)
    return
  }

  say("")
  say("启动：")
  say("  make serve        # 构建页面 + 从 web/ 起服务端")
  say("  或者手动：cd web && ../_build/native/debug/build/web/cmd/server/server.exe")
  say("  然后打开 http://127.0.0.1:8137/")
}
